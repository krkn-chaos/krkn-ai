FROM python:3.12-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY README.md ./
COPY krkn_ai ./krkn_ai
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="Krkn-AI artifact service" \
      org.opencontainers.image.description="Private artifact service for Krkn-AI runs" \
      org.opencontainers.image.source="https://github.com/krkn-chaos/krkn-ai" \
      org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 krkn-ai \
    && mkdir -p /var/lib/krkn-ai

COPY --from=builder /app /app
RUN chown -R krkn-ai:krkn-ai /app /var/lib/krkn-ai

USER 1001
ENV PATH="/app/.venv/bin:$PATH" \
    KRKNAI_ARTIFACT_ROOT=/var/lib/krkn-ai

EXPOSE 8080
ENTRYPOINT ["uvicorn", "krkn_ai.server:app", "--host", "0.0.0.0", "--port", "8080"]
